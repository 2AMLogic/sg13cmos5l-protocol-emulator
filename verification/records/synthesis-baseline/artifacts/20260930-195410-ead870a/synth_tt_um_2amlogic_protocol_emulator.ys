# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_tt_um_2amlogic_protocol_emulator.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog flow/blackbox-RM_IHPSG13_1P_256x16_c2_bm_bist.v
read_verilog src/tt_um_2amlogic_protocol_emulator.v
read_verilog rtl/protocol_core.v
read_verilog rtl/protocol_program_memory.v
hierarchy -check -top tt_um_2amlogic_protocol_emulator
synth -top tt_um_2amlogic_protocol_emulator
dfflibmap -liberty $PDK_ROOT/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/lib/sg13cmos5l_stdcell_typ_1p20V_25C.lib
abc -liberty $PDK_ROOT/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/lib/sg13cmos5l_stdcell_typ_1p20V_25C.lib -D 20000
clean
tee -q -o flow/.klt/synthesize/run-67f88be60c2244f8b072a4e25efae142/tt_um_2amlogic_protocol_emulator_stats.json stat -liberty $PDK_ROOT/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/lib/sg13cmos5l_stdcell_typ_1p20V_25C.lib -json -top tt_um_2amlogic_protocol_emulator
write_verilog -noattr flow/.klt/synthesize/run-67f88be60c2244f8b072a4e25efae142/tt_um_2amlogic_protocol_emulator_synth.v
