.DS_Store

# synthesis / P&R scratch
flow/build/
flow/.synth-scratch/
# klt's own scratch build dir for `klt synthesize` runs
flow/.klt/
# `klt sta` corner-sweep scratch: per-corner request dirs, swept-netlist
# staging, and the sweep summary
flow/sta-corners/
flow/sta-sweep/
flow/sta-corner-sweep-results.json
# `klt place-and-route` die-area scratch: per-design request/response
# docs, frozen netlists, and the summary (issue #21)
flow/par-scratch/
flow/die-area-par-results.json
# `klt functional-verification` post-route SDF sweep scratch: downloaded
# gds-workflow artifacts, frozen netlist/SDF staging, per-corner request
# dirs, and the sweep summary (issue #26)
flow/post-layout-sdf/
flow/post-layout-sdf-results.json
# SRAM-macro feasibility probe summary: regenerated on demand from the PDK
# and the vendored upstream tables, frozen per-run under
# verification/records/program-memory-macro-feasibility/artifacts/ (issue #39)
flow/sram-macro-feasibility-results.json
# local klt install, created by the setup script
.venv/
# klt's own scratch build dir for `klt functional-verification` runs
verification/.klt/
# klt's scratch build dir for `klt synthesize` runs (netlists under
# flow/synthesize-*.json land here unless --out-dir is given; first
# exercised by issue #19's program-memory recipe flow run)
flow/.klt/

